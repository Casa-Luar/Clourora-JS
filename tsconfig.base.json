{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "paths": {
      "@clourora/sdk": ["./packages/sdk/src/index.ts"],
      "@clourora/sdk/server": ["./packages/sdk/src/server.ts"]
    }
  }
}
