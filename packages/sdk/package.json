{
  "name": "@clourora/sdk",
  "version": "0.1.0",
  "description": "Typed client for Clourora's public API (adoptions, more to come). No dependencies; runs in browsers, Node 20+, Deno, Bun and edge runtimes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "clourora",
    "pets",
    "adoption",
    "veterinary",
    "sdk"
  ],
  "homepage": "https://clourora.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Casa-Luar/Clourora-JS.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/Casa-Luar/Clourora-JS/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  }
}
